generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum MembershipRole { PLATFORM_ADMIN OWNER SALES_AGENT WAREHOUSE_MANAGER DRIVER ACCOUNTANT VIEWER }
enum OrderStatus { DRAFT CONFIRMED PREPARED OUT_FOR_DELIVERY DELIVERED PARTIALLY_DELIVERED CANCELLED RETURNED }
enum MovementType { PURCHASE_RECEIPT SALE RETURN DAMAGE ADJUSTMENT TRANSFER_IN TRANSFER_OUT }
enum LedgerType { INVOICE COLLECTION CREDIT ADJUSTMENT }

model Tenant {
  id String @id @default(cuid())
  name String
  taxIdentifier String? @unique
  currency String @default("TND")
  timezone String @default("Africa/Tunis")
  createdAt DateTime @default(now())
  memberships Membership[]
  customers Customer[]
  products Product[]
  warehouses Warehouse[]
  orders SalesOrder[]
}
model User { id String @id @default(cuid()) email String @unique name String memberships Membership[] createdAt DateTime @default(now()) }
model Membership { id String @id @default(cuid()) tenantId String userId String role MembershipRole tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@unique([tenantId,userId]) }
model Customer { id String @id @default(cuid()) tenantId String name String phone String? taxIdentifier String? creditLimit Decimal @default(0) paymentTermsDays Int @default(0) tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) addresses CustomerAddress[] orders SalesOrder[] ledger CustomerLedgerEntry[] @@unique([tenantId,phone]) @@unique([tenantId,taxIdentifier]) }
model CustomerAddress { id String @id @default(cuid()) customerId String label String address String isDefault Boolean @default(false) customer Customer @relation(fields:[customerId],references:[id],onDelete:Cascade) }
model Product { id String @id @default(cuid()) tenantId String sku String name String unit String @default("Pièce") sellingPrice Decimal taxRate Decimal @default(19) minimumStock Decimal @default(0) active Boolean @default(true) tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) stockLevels StockLevel[] orderItems SalesOrderItem[] @@unique([tenantId,sku]) }
model Warehouse { id String @id @default(cuid()) tenantId String name String tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) stockLevels StockLevel[] movements StockMovement[] }
model StockLevel { id String @id @default(cuid()) productId String warehouseId String quantity Decimal @default(0) product Product @relation(fields:[productId],references:[id],onDelete:Cascade) warehouse Warehouse @relation(fields:[warehouseId],references:[id],onDelete:Cascade) @@unique([productId,warehouseId]) }
model StockMovement { id String @id @default(cuid()) warehouseId String productId String type MovementType quantity Decimal createdAt DateTime @default(now()) createdById String reference String? warehouse Warehouse @relation(fields:[warehouseId],references:[id]) }
model SalesOrder { id String @id @default(cuid()) tenantId String customerId String number String status OrderStatus @default(DRAFT) requestedDate DateTime? total Decimal @default(0) createdAt DateTime @default(now()) tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) customer Customer @relation(fields:[customerId],references:[id]) items SalesOrderItem[] @@unique([tenantId,number]) }
model SalesOrderItem { id String @id @default(cuid()) orderId String productId String quantity Decimal unitPrice Decimal taxRate Decimal order SalesOrder @relation(fields:[orderId],references:[id],onDelete:Cascade) product Product @relation(fields:[productId],references:[id]) }
model CustomerLedgerEntry { id String @id @default(cuid()) customerId String type LedgerType amount Decimal dueDate DateTime? createdAt DateTime @default(now()) reference String? customer Customer @relation(fields:[customerId],references:[id]) }
