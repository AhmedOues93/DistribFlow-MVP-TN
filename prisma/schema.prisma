generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  PLATFORM_ADMIN
  OWNER
  ADMIN
  SALES
  WAREHOUSE
  SALES_AGENT
  WAREHOUSE_MANAGER
  DRIVER
  ACCOUNTANT
  VIEWER
  READ_ONLY
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PREPARATION
  PREPARED
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  PARTIALLY_DELIVERED
  CANCELLED
  RETURNED
}

enum OrderSource {
  MANUAL
  WHATSAPP
}

enum MovementType {
  PURCHASE_RECEIPT
  SALE
  RETURN
  DAMAGE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

enum LedgerType {
  INVOICE
  COLLECTION
  CREDIT
  ADJUSTMENT
}

model Tenant {
  id             String             @id @default(cuid())
  name           String
  taxIdentifier  String?            @unique
  currency       String             @default("TND")
  timezone       String             @default("Africa/Tunis")
  createdAt      DateTime           @default(now())
  memberships    Membership[]
  customers      Customer[]
  products       Product[]
  warehouses     Warehouse[]
  orders         SalesOrder[]
  invitations    Invitation[]
  categories     ProductCategory[]
  units          Unit[]
  auditEvents    AuditEvent[]
  importBatches  ImportBatch[]
  orderSequences OrderSequence[]
  reservations   OrderReservation[]
  suspendedAt    DateTime?
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  memberships  Membership[]
  createdAt    DateTime     @default(now())
  passwordHash String
  passwordSet  Boolean      @default(true)
  sessions     Session[]
}

model Membership {
  id          String           @id @default(cuid())
  tenantId    String
  userId      String
  role        MembershipRole
  status      MembershipStatus @default(ACTIVE)
  invitedAt   DateTime?
  activatedAt DateTime?
  suspendedAt DateTime?
  archivedAt  DateTime?
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, status, role])
}

model Session {
  id             String   @id @default(cuid())
  tokenHash      String   @unique
  userId         String
  activeTenantId String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invitation {
  id          String         @id @default(cuid())
  tenantId    String
  name        String
  email       String
  role        MembershipRole
  tokenHash   String         @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdById String?
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId, acceptedAt, revokedAt, expiresAt])
}

model Customer {
  id               String                @id @default(cuid())
  tenantId         String
  name             String
  phone            String?
  taxIdentifier    String?
  creditLimit      Decimal               @default(0)
  paymentTermsDays Int                   @default(0)
  whatsapp         String?
  notes            String?
  active           Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addresses        CustomerAddress[]
  orders           SalesOrder[]
  ledger           CustomerLedgerEntry[]

  @@unique([tenantId, phone])
  @@unique([tenantId, taxIdentifier])
  @@index([tenantId, active, name])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  label      String
  address    String
  isDefault  Boolean  @default(false)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Product {
  id                String             @id @default(cuid())
  tenantId          String
  sku               String
  name              String
  description       String?
  unit              String             @default("Pièce")
  categoryId        String?
  barcode           String?
  purchasePrice     Decimal            @default(0)
  sellingPrice      Decimal
  taxRate           Decimal            @default(19)
  minimumStock      Decimal            @default(0)
  active            Boolean            @default(true)
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category          ProductCategory?   @relation(fields: [categoryId], references: [id])
  stockLevels       StockLevel[]
  movements         StockMovement[]
  orderItems        SalesOrderItem[]
  orderReservations OrderReservation[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
}

model ProductCategory {
  id       String    @id @default(cuid())
  tenantId String
  name     String
  active   Boolean   @default(true)
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
}

model Unit {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  symbol   String
  active   Boolean @default(true)
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, symbol])
}

model Warehouse {
  id                String             @id @default(cuid())
  tenantId          String
  code              String
  name              String
  address           String?
  city              String?
  contactName       String?
  contactPhone      String?
  active            Boolean            @default(true)
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockLevels       StockLevel[]
  movements         StockMovement[]
  orders            SalesOrder[]
  orderReservations OrderReservation[]

  @@unique([tenantId, code])
  @@index([tenantId, active, name])
}

model StockLevel {
  id          String    @id @default(cuid())
  productId   String
  warehouseId String
  quantity    Decimal   @default(0)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
}

model StockMovement {
  id             String       @id @default(cuid())
  warehouseId    String
  productId      String
  type           MovementType
  quantity       Decimal
  createdAt      DateTime     @default(now())
  createdById    String
  reference      String?
  notes          String?
  idempotencyKey String?
  transferId     String?
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id])
  product        Product      @relation(fields: [productId], references: [id])

  @@unique([warehouseId, idempotencyKey])
  @@index([productId, warehouseId, createdAt])
}

model AuditEvent {
  id        String   @id @default(cuid())
  tenantId  String
  actorId   String
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model ImportBatch {
  id          String   @id @default(cuid())
  tenantId    String
  kind        String
  createdById String
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model SalesOrder {
  id                String               @id @default(cuid())
  tenantId          String
  customerId        String
  warehouseId       String?
  number            String
  source            OrderSource          @default(MANUAL)
  status            OrderStatus          @default(DRAFT)
  orderDate         DateTime             @default(now())
  requestedDate     DateTime?
  customerReference String?
  notes             String?
  subtotal          Decimal              @default(0)
  discount          Decimal              @default(0)
  tax               Decimal              @default(0)
  total             Decimal              @default(0)
  createdById       String?
  confirmedById     String?
  confirmedAt       DateTime?
  preparedById      String?
  preparedAt        DateTime?
  cancelledById     String?
  cancelledAt       DateTime?
  cancelReason      String?
  archivedAt        DateTime?
  version           Int                  @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          Customer             @relation(fields: [customerId], references: [id])
  warehouse         Warehouse?           @relation(fields: [warehouseId], references: [id])
  items             SalesOrderItem[]
  statusHistory     OrderStatusHistory[]
  reservations      OrderReservation[]
  preparation       OrderPreparation?

  @@unique([tenantId, number])
  @@index([tenantId, status, orderDate])
  @@index([tenantId, warehouseId, requestedDate])
}

model SalesOrderItem {
  id                  String     @id @default(cuid())
  orderId             String
  productId           String
  descriptionSnapshot String?
  skuSnapshot         String     @default("")
  unitSnapshot        String     @default("")
  quantity            Decimal
  preparedQuantity    Decimal    @default(0)
  unitPrice           Decimal
  discount            Decimal    @default(0)
  taxRate             Decimal
  lineSubtotal        Decimal    @default(0)
  lineTotal           Decimal    @default(0)
  order               SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product    @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model OrderSequence {
  tenantId   String   @id
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model OrderStatusHistory {
  id             String       @id @default(cuid())
  orderId        String
  fromStatus     OrderStatus?
  toStatus       OrderStatus
  actorId        String
  idempotencyKey String?
  note           String?
  createdAt      DateTime     @default(now())
  order          SalesOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, idempotencyKey])
  @@index([orderId, createdAt])
}

model OrderReservation {
  id               String     @id @default(cuid())
  tenantId         String
  orderId          String
  productId        String
  warehouseId      String
  quantity         Decimal
  consumedQuantity Decimal    @default(0)
  releasedAt       DateTime?
  consumedAt       DateTime?
  createdAt        DateTime   @default(now())
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order            SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product    @relation(fields: [productId], references: [id])
  warehouse        Warehouse  @relation(fields: [warehouseId], references: [id])

  @@unique([orderId, productId, warehouseId])
  @@index([tenantId, warehouseId, productId, releasedAt, consumedAt])
}

model OrderPreparation {
  id          String     @id @default(cuid())
  orderId     String     @unique
  startedById String
  startedAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  order       SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model CustomerLedgerEntry {
  id         String     @id @default(cuid())
  customerId String
  type       LedgerType
  amount     Decimal
  dueDate    DateTime?
  createdAt  DateTime   @default(now())
  reference  String?
  customer   Customer   @relation(fields: [customerId], references: [id])
}
